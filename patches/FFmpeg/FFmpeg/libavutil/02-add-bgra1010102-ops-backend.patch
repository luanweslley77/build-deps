diff --git a/libswscale/uops.c b/libswscale/uops.c
index 4c37a65829..565ca8bb0d 100644
--- a/libswscale/uops.c
+++ b/libswscale/uops.c
@@ -974,6 +974,42 @@ static int free_uop_key(void *opaque, void *key)
     return 0;
 }
 
+typedef struct MirrorUOps {
+    SwsUOp key;
+    SwsUOp *ops;
+    int num;
+    int cap;
+    int err;
+} MirrorUOps;
+
+static int mirror_uop_cmp(void *opaque, void *elem)
+{
+    const MirrorUOps *m = opaque;
+    const SwsUOp *b = elem;
+    if (m->key.type != b->type)
+        return (int) b->type - m->key.type;
+    if (m->key.uop != b->uop)
+        return (int) b->uop - m->key.uop;
+    return 0;
+}
+
+static int collect_uop(void *opaque, void *elem)
+{
+    MirrorUOps *list = opaque;
+    if (list->num >= list->cap) {
+        const int cap = list->cap ? list->cap * 2 : 32;
+        SwsUOp *ops = av_realloc_array(list->ops, cap, sizeof(*ops));
+        if (!ops) {
+            list->err = 1;
+            return 1; /* stop enumeration */
+        }
+        list->ops = ops;
+        list->cap = cap;
+    }
+    list->ops[list->num++] = *(const SwsUOp *) elem;
+    return 0;
+}
+
 int ff_sws_uops_macros_gen(char **out_str)
 {
     int ret;
@@ -1029,6 +1065,42 @@ int ff_sws_uops_macros_gen(char **out_str)
         }
     }
 
+    /**
+     * Permutations and copies are type-agnostic for the template-based
+     * backends, but the enumeration above only registers the combinations that
+     * occur for the format set it was run against. Mirror the integer entries
+     * to float so that float-domain swizzles (e.g. as produced by the optimizer
+     * when it splits a non-diagonal linear operation) can be compiled as well.
+     */
+    for (enum SwsPixelType type = SWS_PIXEL_NONE+1; type < SWS_PIXEL_TYPE_NB; type++) {
+        static const SwsUOpType mirrored[] = { SWS_UOP_PERMUTE, SWS_UOP_COPY };
+
+        if (type == SWS_PIXEL_F32)
+            continue;
+
+        for (int i = 0; i < FF_ARRAY_ELEMS(mirrored); i++) {
+            MirrorUOps list = { .key = { .type = type, .uop = mirrored[i] } };
+
+            av_tree_enumerate(root, &list, mirror_uop_cmp, collect_uop);
+            if (list.err) {
+                av_free(list.ops);
+                ret = AVERROR(ENOMEM);
+                goto fail;
+            }
+
+            for (int j = 0; j < list.num; j++) {
+                list.ops[j].type = SWS_PIXEL_F32;
+                ret = register_uop(&root, &list.ops[j]);
+                if (ret < 0) {
+                    av_free(list.ops);
+                    goto fail;
+                }
+            }
+
+            av_free(list.ops);
+        }
+    }
+
     #define BPRINT_STR(str) av_bprint_append_data(bp, str, strlen(str))
     BPRINT_STR(
 "/**\n"
