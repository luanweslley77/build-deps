diff --git a/source/cmake/Version.cmake b/source/cmake/Version.cmake
index 3bbf42f..4a5ca1b 100644
--- a/source/cmake/Version.cmake
+++ b/source/cmake/Version.cmake
@@ -29,6 +29,15 @@ set(X265_VERSION "unknown")
 set(X265_LATEST_TAG "0.0")
 set(X265_TAG_DISTANCE "0")
 
+# X265_VERSION_OVERRIDE pins the version reported by x265 and x265.pc when the
+# source tree is not a git/hg checkout with tags, or when the copied tree must
+# not depend on git metadata. It mirrors the vcpkg port's version.patch.
+if(X265_VERSION_OVERRIDE)
+    set(X265_VERSION "${X265_VERSION_OVERRIDE}")
+    set(X265_LATEST_TAG "${X265_VERSION_OVERRIDE}")
+    return()
+endif()
+
 #Find version control software to be used for live and extracted repositories from compressed tarballs
 if(CMAKE_VERSION VERSION_LESS "2.8.10")
     find_program(HG_EXECUTABLE hg)
